# Copy to .env.local for local dev. Vercel env is the source of truth in production.
# Pulled automatically by `vercel env pull .env.local` after `vercel link`.

# --- Supabase (auto-provisioned via Vercel Marketplace) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# --- MailerLite (transactional + marketing) ---
MAILERLITE_API_KEY=
MAILERLITE_FROM_EMAIL=
MAILERLITE_FROM_NAME=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated Supabase user IDs allowed to access /admin
ADMIN_USER_IDS=

# --- Sentry (Week 5) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
